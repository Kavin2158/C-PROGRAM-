// Program to find square root and cube of the given number

#include <stdio.h>
#include <math.h>

int main() {
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("Square root of %d = %.3f\n", n, sqrt(n));
    printf("Cube of %d = %.f\n", n, pow(n, 3));

    return 0;
}


Output

Enter a number: 2
Square root of 2 = 1.414
Cube of 2 = 8

