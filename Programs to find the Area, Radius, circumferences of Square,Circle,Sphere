//Program to multiply and divide two numbers and print them in thee format of equation (4*3=12 4/2=2)

#include <stdio.h>

int main() {
    int a,b;

    printf("Enter two numbers: ");
    scanf("%d%d",&a,&b);

    printf("%d*%d=%d\n",a,b,a*b);
    printf("%d/%d=%d\n",a,b,a/b);

    return 0;
}

Output

Enter two numbers: 80 10
80*10=800
80/10=8

